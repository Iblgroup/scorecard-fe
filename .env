VITE_API_BASE_URL=http://localhost:3005/api

# Authenticator portal — where an unauthenticated visitor is sent. Without this
# session.ts falls back to the DEPLOYED portal (208.110.83.26:4001), which then
# bounces back to a localhost URL it cannot issue a ticket for.
VITE_AUTH_PORTAL_URL=http://localhost:5173
# Authenticator API — used once, to redeem the one-time handoff ticket.
VITE_AUTH_API_URL=http://localhost:4002/api
